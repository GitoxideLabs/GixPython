def build_features() -> list[str]: ...

class HashKind:
    SHA1: ClassVar[HashKind | None]
    SHA256: ClassVar[HashKind | None]
    def __init__(self, name: str) -> None: ...
    def len_in_bytes(self) -> int: ...
    def len_in_hex(self) -> int: ...
    def null(self) -> ObjectId: ...
    def empty_blob(self) -> ObjectId: ...
    def empty_tree(self) -> ObjectId: ...
    @staticmethod
    def all() -> list[HashKind]: ...

class ObjectId:
    def __init__(self, hex: str | bytes) -> None: ...
    @staticmethod
    def from_hex(hex: str | bytes) -> ObjectId: ...
    def kind(self) -> HashKind: ...
    def is_null(self) -> bool: ...
    def as_bytes(self) -> bytes: ...
    def __bytes__(self) -> bytes: ...

class OpenOptions:
    def __init__(self) -> None: ...
    @staticmethod
    def isolated() -> OpenOptions: ...
    def config_overrides(self, values: list[str]) -> Self: ...
    def cli_overrides(self, values: list[str]) -> Self: ...
    def open_path_as_is(self, enable: bool) -> Self: ...
    def bail_if_untrusted(self, enable: bool) -> Self: ...
    def strict_config(self, enable: bool) -> Self: ...
    def lossy_config(self, enable: bool) -> Self: ...
    def open(self, path: _Path) -> Repository: ...

