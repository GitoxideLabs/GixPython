    def index_path(self) -> str: ...
    def prefix(self) -> str | None: ...
    def is_bare(self) -> bool: ...
    def is_pristine(self) -> bool | None: ...
    def kind(self) -> str: ...
    def state(self) -> str | None: ...
    def object_hash(self) -> HashKind: ...
